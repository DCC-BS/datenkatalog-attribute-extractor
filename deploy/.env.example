# Copy to .env next to docker-compose.yml. Everything else uses the defaults baked into the image.

# Base URL of an OpenAI-compatible API, including /v1 and without a trailing slash.
# From inside the container, "localhost" is the container itself: for an LLM on the same host
# use http://host.docker.internal:8000/v1 (and add `extra_hosts: ["host.docker.internal:host-gateway"]`
# to app-backend on Linux) or the host's address.
LLM_URL=https://llm.example.com/v1

# Model name exactly as the API lists it under /models. The vision model must accept images.
LLM_MODEL=Gemma/Gemma-4-31B

# API key sent as a bearer token. A local vLLM without --api-key ignores it.
LLM_API_KEY=not-needed

# Optional: host port of the UI (default 8501) and the image tag to run (default latest).
# PORT=8501
# IMAGE_TAG=latest
