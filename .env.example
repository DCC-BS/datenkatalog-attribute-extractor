# Copy to .env and adjust. The AppConfig section can be regenerated with `make env-example`;
# the logging and docker-compose sections are maintained by hand, because those variables are
# read by dcc-backend-common and by docker compose rather than by AppConfig.

# --- logging (read by dcc_backend_common.logger) ---

# REQUIRED. init_logger() raises AppConfigError without it. "true" switches to JSON output.
IS_PROD=false

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Traceback style in development: focused or rich
DEV_TRACEBACK_STYLE=focused

# --- AppConfig ---

# The model for LLM API. Must match --served-model-name in docker/services.compose.yml
LLM_MODEL=Gemma/Gemma-4-31B

# The URL for LLM API
LLM_URL=http://localhost:8001/v1

# The API key for authenticating with OpenAI. A local vLLM ignores it.
LLM_API_KEY=not-needed

# The timeout for LLM API requests in seconds
LLM_TIMEOUT=300

# The maximum number of retries for LLM API requests
LLM_MAX_RETRIES=2

# Health endpoint of the LLM service, used by the readiness probe
LLM_HEALTH_CHECK_URL=http://localhost:8001/health

# Seconds to wait for the LLM health check before failing an extraction fast
LLM_HEALTH_TIMEOUT=5

# Refuse to extract if the served max_model_len is below this
LLM_MIN_CONTEXT_TOKENS=8192

# Pages sent to the LLM at once. Keep aligned with the vLLM --max-num-seqs setting
LLM_MAX_CONCURRENCY=1

# Resolution used to rasterise PDF pages before sending them to the model
PDF_RENDER_DPI=200

# Maximum number of pages processed per document
MAX_PAGES=30

# Maximum accepted upload size in megabytes
MAX_UPLOAD_MB=25

# Base URL of the Firecrawl instance used to scrape web forms. With the `web` compose profile
# this is http://firecrawl-api:3002 inside the network; in production it is the cluster instance.
FIRECRAWL_API_URL=http://localhost:3002

# Seconds to wait for a Firecrawl scrape, which renders the page in a real browser
FIRECRAWL_TIMEOUT=120

# Milliseconds the browser waits after load before the HTML is read. Client-rendered forms
# (Vaadin, React) return only their loading shell without this; measured 5000 was enough on
# the Vaadin form that prompted it, 3000 was not.
FIRECRAWL_WAIT_MS=8000

# Maximum HTML chunks processed per web page, mirroring MAX_PAGES
MAX_WEB_UNITS=30

# Origin allowed by CORS
CLIENT_URL=http://localhost:8501

# Base URL the Streamlit UI uses to reach this API
BACKEND_URL=http://localhost:8000

# --- docker compose only ---

# Host port mappings for the dev stack
LLM_API_PORT=8001
BACKEND_PORT=8000
FRONTEND_PORT=8501

# How many GPUs the vLLM container gets (must be >= LLM_TENSOR_PARALLEL_SIZE)
LLM_GPU_COUNT=2

# vLLM model and serving knobs
LLM_HF_MODEL=RedHatAI/gemma-4-31B-it-NVFP4
LLM_TENSOR_PARALLEL_SIZE=2
LLM_MAX_NUM_SEQS=1
# Set explicitly. 'auto' silently shrinks to the leftover KV cache (2544 tokens on one 4090).
LLM_MAX_MODEL_LEN=16384

# Per-image token budget. Allowed: 70, 140, 280, 560, 1120. Higher reads small labels better.
LLM_IMAGE_SOFT_TOKENS=560

# Needed only to download gated models
HUGGING_FACE_HUB_TOKEN=
HUGGING_FACE_CACHE_DIR=

# --- Firecrawl, docker compose only (started by `make docker-up-web`) ---

# Host port for the Firecrawl API. Only needed to reach it from outside the compose network.
FIRECRAWL_PORT=3002

# Firecrawl's own postgres. Self-hosted runs with USE_DB_AUTHENTICATION=false, so these are
# internal to the Firecrawl stack and never used to authenticate our requests.
FIRECRAWL_POSTGRES_USER=postgres
FIRECRAWL_POSTGRES_PASSWORD=postgres
FIRECRAWL_POSTGRES_DB=postgres

# Scrape concurrency and browser pool. We scrape one URL at a time, so these are headroom.
FIRECRAWL_WORKERS_PER_QUEUE=8
FIRECRAWL_CONCURRENT_REQUESTS=10
FIRECRAWL_MAX_CONCURRENT_JOBS=5
FIRECRAWL_BROWSER_POOL_SIZE=5
FIRECRAWL_LOGGING_LEVEL=INFO
